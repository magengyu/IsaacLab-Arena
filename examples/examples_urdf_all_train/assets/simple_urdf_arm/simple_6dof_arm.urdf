<?xml version="1.0"?>
<robot name="simple_6dof_arm">
  <!--
    A deliberately tiny 6-DOF serial arm for learning the URDF -> USD -> Isaac Lab path.
    It uses only primitive shapes, so there are no mesh files to resolve.
  -->

  <material name="base_gray">
    <color rgba="0.35 0.38 0.42 1"/>
  </material>
  <material name="link_blue">
    <color rgba="0.10 0.34 0.80 1"/>
  </material>
  <material name="link_green">
    <color rgba="0.12 0.55 0.35 1"/>
  </material>
  <material name="tool_red">
    <color rgba="0.82 0.16 0.16 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
      <material name="base_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.24"/>
      </geometry>
      <material name="link_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.24"/>
      </geometry>
    </collision>
  </link>

  <link name="link_2">
    <inertial>
      <origin xyz="0.13 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0.13 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.06 0.06"/>
      </geometry>
      <material name="link_green"/>
    </visual>
    <collision>
      <origin xyz="0.13 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.06 0.06"/>
      </geometry>
    </collision>
  </link>

  <link name="link_3">
    <inertial>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.05 0.05"/>
      </geometry>
      <material name="link_blue"/>
    </visual>
    <collision>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.24 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="link_4">
    <inertial>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.045 0.045"/>
      </geometry>
      <material name="link_green"/>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.045 0.045"/>
      </geometry>
    </collision>
  </link>

  <link name="link_5">
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.04 0.04"/>
      </geometry>
      <material name="link_blue"/>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.04 0.04"/>
      </geometry>
    </collision>
  </link>

  <link name="link_6">
    <inertial>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.035 0.035"/>
      </geometry>
      <material name="tool_red"/>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.035 0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="2.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="20" velocity="2.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.26 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="16" velocity="2.5"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="12" velocity="3.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="8" velocity="3.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.11 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="6" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
</robot>
